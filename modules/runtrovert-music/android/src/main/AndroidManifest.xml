<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 11+ hides other apps unless we name them. Only used to show which
       music and podcast apps are installed and to open the one you picked. -->
  <queries>
    <package android:name="com.spotify.music" />
    <package android:name="com.google.android.apps.youtube.music" />
    <package android:name="com.apple.android.music" />
    <package android:name="com.amazon.mp3" />
    <package android:name="deezer.android.app" />
    <package android:name="com.aspiro.tidal" />
    <package android:name="com.soundcloud.android" />
    <package android:name="au.com.shiftyjelly.pocketcasts" />
    <package android:name="de.danoeh.antennapod" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.APP_MUSIC" />
    </intent>
  </queries>

  <application>
    <!-- Only so the music bar can show the song's title, artist and cover. Does nothing
         until the runner turns on notification access for Runtrovert; reads no
         notifications (see NowPlayingListener.kt). -->
    <service
      android:name="app.runtrovert.music.NowPlayingListener"
      android:label="Runtrovert: show what's playing"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>

{
  "expo": {
    "name": "Runtrovert",
    "slug": "runtrovert",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/bg-dusk.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#d9c9b8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.runtrovert",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Runtrovert uses your location to record your runs. Your runs are saved on this phone, not on a server of ours. While a map is on screen, the map service sees which area it shows. With weather on, the forecast service gets a location rounded to about 1 km.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Runtrovert uses background location so your run keeps recording with the screen off. Your runs are saved on this phone, not on a server of ours.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "spotify",
          "youtubemusic",
          "music",
          "deezer",
          "tidal",
          "soundcloud",
          "pktc",
          "podcasts"
        ]
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "app.runtrovert",
      "adaptiveIcon": {
        "backgroundColor": "#f6f1ea",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Runtrovert uses background location so your run keeps recording with the screen off. Your runs are saved on this phone, not on a server of ours.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2b2733",
          "defaultChannel": "runtrovert-quiet"
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bg-dusk.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#d9c9b8"
        }
      ],
      "expo-sharing",
      "expo-iap"
    ]
  }
}
